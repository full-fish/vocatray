{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VocaTray",
  "version": "0.1.2",
  "identifier": "com.vocatray.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "hover",
        "url": "index.html#hover",
        "title": "VocaTray",
        "width": 240,
        "height": 120,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "shadow": true
      },
      {
        "label": "click",
        "url": "index.html#click",
        "title": "VocaTray",
        "width": 240,
        "height": 150,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyRjk4RkFEN0U1NEZCMkQKUldRdCsxUityWS81a3NrUWh6bnRIUTZQMzFVNUR2Y3N2OUN0Ynh6c3Q3TjNVSG5jRDNiVm0wOTYK",
      "endpoints": ["https://github.com/full-fish/vocatray/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "FULLFISH",
    "homepage": "https://full-fish.com/apps/vocatray/",
    "copyright": "© 2026 FULLFISH",
    "shortDescription": "트레이 아이콘에 마우스를 올리면 영단어 카드가 뜨는 단어 암기 앱",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
